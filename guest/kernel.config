# Kernel symbols the guest must have built in (no initramfs: root is on
# virtio-blk, console on a serial port). Merged into
# target/linux/armsr/config-<KERNEL_PATCHVER> by guest_kconfig_merge.
# crosvm gives the guest an 8250 UART; QEMU "virt" gives a PL011.
CONFIG_ARM64=y
CONFIG_ARM_GIC_V3=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_EXT4_FS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
