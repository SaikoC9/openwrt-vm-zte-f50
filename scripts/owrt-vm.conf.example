# Copy to vm.conf next to owrt-vm.sh. Read as shell. Only change what you need.
# Defaults already give hotspot mode: OpenWrt is the DHCP server of the hotspot LAN.
CPUS=2
MEM=256M
HALT_POLL=0              # KVM halt polling ns while the VM runs; empty = leave as is
NET=1
WAN_IF=sipa_eth0         # cellular interface
DNS_UP=8.8.8.8
BOOT_WAIT=60             # seconds to wait for guest ping
WAIT_SVC=1               # also wait for LuCI (needs nc)
SVC_WAIT=60
TEST_WAIT=30

# Hotspot LAN (defaults)
LAN=1                    # guest LAN NIC (eth1), host 192.168.88.2 <-> guest 192.168.88.1
LAN_JOIN=1               # join it to br0 after boot
GUEST_DHCP4=1            # OpenWrt serves DHCPv4; Android's DHCP on br0 is blocked

# Forwards for hotspot clients (defaults)
EXPOSE=1
EXPOSE_IF=br0
HOTSPOT_NET=             # empty = detect from EXPOSE_IF
SSH_PORT=2223            # host port -> guest 22
WEB_PORT=8081            # host port -> guest 80 (not 8080, used on the F50)
